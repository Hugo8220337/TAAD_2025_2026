//////////////////////////////////////////////////////////
//  TABELA DE FACTOS
//////////////////////////////////////////////////////////

// ------------------ FACT: meteorology (fire x date x location) ------------------

Table fact_fire_meteorology {
  id int [pk, increment, note: "Surrogate key for meteorology records (auto-increment)"]
  fire_id varchar [ref: > dim_fire.fire_id, note: "Optional FK to dim_fire"]
  time_id int [ref: > dim_time.time_id]
  location_id int [ref: > dim_location.location_id]

  temp_max float
  temp_min float
  rh_max float
  rh_min float
  precip_sum float
  rain_sum float
  precip_hours int
  wind_max float
  gust_max float
  wind_dir float
  radiation float
  sunshine float
  et0 float

  mean_temp_max float
  mean_temp_min float
  precip_sum_mean float
  wind_max_mean float
  gust_max_mean float
  radiation_mean float
  sunshine_mean float
  et0_mean float

  processing_date datetime

  Note: "Table of meteorological measurements and aggregates per fire × date × location"
}

//////////////////////////////////////////////////////////
//  DIMENSÕES
//////////////////////////////////////////////////////////

Table dim_time {
  time_id int [pk, increment, note: "Surrogate key for the time dimension (auto-increment)"]
  start_date date
  day int
  month int
  year int
  week int
  season varchar
  weekday varchar

  end_date date
  n_days int
  dry_day_sum int
  high_wind_sum int
  
  Note: "Time dimension used in temporal analyses (date attributes + optional fire-period summary fields)"
}

Table dim_location {
  location_id int [pk, increment, note: "Surrogate key for geographic dimension (auto-increment)"]
  district varchar
  municipality varchar
  parish varchar
  centroid_lon float
  centroid_lat float
  latitude float
  longitude float
  altitude float
  nuts3 varchar
  geom geometry

  Note: 'Geographic dimension — administrative information and coordinates.'
}

Table dim_fire {
  fire_id varchar [pk, note: "Original ICNF fire identifier (natural key)"]
  icnf_code varchar [note: "Original ICNF code (if different)"]
  name varchar [note: "Optional descriptive name/label"]
  t0 date [note: "Reported fire start date/time (if available)"]
  burnt_area_m2 float [note: "Area reported by ICNF (m²)"]
  duration_reported_hours float [note: "Reported duration in hours (if available)"]
  cause varchar [note: "Textual cause (as in ICNF)"]
  fuel_type varchar [note: "Reported fuel / vegetation type"]
  district varchar
  municipality varchar
  note varchar [note: "Ingestion / quality notes"]
  processing_date datetime

  Note: "Metadata about the fire from ICNF / ingestion; used as a join target"
}

