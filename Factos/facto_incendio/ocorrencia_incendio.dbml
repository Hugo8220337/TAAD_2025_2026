//////////////////////////////////////////////////////////
//  TABELA DE FACTOS
//////////////////////////////////////////////////////////

// ------------------ FACT: general fire metrics ------------------

Table fact_fire {
  fire_id varchar [pk, note: "Original ICNF fire identifier (natural key)"]
  window varchar [note: 'Time window (pre_90, pre_30, post_90)']
  time_id int [ref: > dim_time.time_id]
  location_id int [ref: > dim_location.location_id]
  fire_type_id int [ref: > dim_fire_type.fire_type_id]
  cause_id int [ref: > dim_cause.cause_id]
  meteo_fact_id int [note: 'Optional link to the meteo fact']

  area_total_m2 float
  area_pov_m2 float
  area_shrub_m2 float
  area_agri_m2 float
  duration_hours float
  perimeter_m float

  processing_date datetime

  Note: 'Main fact table — measures associated with each fire'
}

//////////////////////////////////////////////////////////
//  DIMENSÕES
//////////////////////////////////////////////////////////

Table dim_time {
  time_id int [pk, increment, note: "Surrogate key for the time dimension (auto-increment)"]
  start_date date
  day int
  month int
  year int
  week int
  season varchar
  weekday varchar

  end_date date
  n_days int
  dry_day_sum int
  high_wind_sum int

  Note: "Time dimension used in temporal analyses (date attributes + optional fire-period summary fields)"
}

Table dim_location {
  location_id int [pk, increment, note: "Surrogate key for geographic dimension (auto-increment)"]
  district varchar
  municipality varchar
  parish varchar
  centroid_lon float
  centroid_lat float
  latitude float
  longitude float
  altitude float
  nuts3 varchar
  geom geometry

  Note: 'Geographic dimension — administrative information and coordinates.'
}

Table dim_fire_type {
  fire_type_id int [pk, increment, note: "Surrogate key for fire type classification (auto-increment)"]
  type_name varchar
  is_control_burn boolean
  is_false_alarm boolean
  is_agricultural boolean

  Note: 'Classification of fire types used to categorize fire events'
}

Table dim_cause {
  cause_id int [pk, increment, note: "Surrogate key for cause taxonomy (auto-increment)"]
  cause_name varchar
  cause_category varchar
  cause_family varchar

  Note: 'Cause taxonomy for fires (detailed and aggregated levels)'
}

Table dim_meteorology {
  meteorology_id int [pk, increment, note: "Surrogate key for meteorology summary (auto-increment)"]
  fire_id varchar [ref: > dim_fire.fire_id, note: "FK linking to dim_fire (when available)"]
  mean_temp_max float
  mean_temp_min float
  rh_max_mean float
  rh_min_mean float
  precip_sum_mean float
  rain_sum_mean float
  wind_max_mean float
  gust_max_mean float
  radiation_mean float
  sunshine_mean float
  et0_mean float
  dry_day_sum int
  high_wind_sum int
  processing_date datetime

  Note: "Meteorological summary aggregated per fire (validation / summary dataset)"
}
